rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mondal.saikat185@gmail.com'
      );
    }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status', 'createdAt', 'updatedAt']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && (data.role == 'student' || data.role == 'admin') &&
             data.status is string && (data.status == 'pending' || data.status == 'active' || data.status == 'inactive' || data.status == 'rejected') &&
             (!('displayName' in data) || data.displayName == null || data.displayName is string) &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL is string) &&
             (!('fullName' in data) || data.fullName == null || data.fullName is string) &&
             (!('address' in data) || data.address == null || data.address is string) &&
             (!('dob' in data) || data.dob == null || data.dob is string) &&
             (!('joinDate' in data) || data.joinDate == null || data.joinDate is string) &&
             (!('phone' in data) || data.phone == null || data.phone is string) &&
             (!('batchId' in data) || data.batchId == null || data.batchId is string) &&
             (!('profilePhotoUrl' in data) || data.profilePhotoUrl == null || data.profilePhotoUrl is string) &&
             (!('isProfileComplete' in data) || data.isProfileComplete == null || data.isProfileComplete is bool) &&
             (!('monthlyFee' in data) || data.monthlyFee == null || data.monthlyFee is number) &&
             (!('exemptReason' in data) || data.exemptReason == null || data.exemptReason is string) &&
             (!('pendingMonths' in data) || data.pendingMonths == null || data.pendingMonths is number) &&
             (!('showPaymentNudge' in data) || data.showPaymentNudge == null || data.showPaymentNudge is bool) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin()) &&
                    isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
                    (isAdmin() || (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(
                      ['updatedAt', 'fullName', 'address', 'dob', 'joinDate', 'phone',
                       'photoURL', 'profilePhotoUrl', 'isProfileComplete', 'batchId']
                    )));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /batchNotes/{batchNoteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /library/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /libraryChunks/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /batchAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /examSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['participantUids'])
      );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['presentStudentIds', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
